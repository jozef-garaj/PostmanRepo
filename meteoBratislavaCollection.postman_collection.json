            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\nconst jsonData = pm.response.json();\r\n\r\npm.test(\"Current weather data is present\", function () {\r\n    pm.expect(jsonData.current).to.have.property(\"temperature_2m\");\r\n    pm.expect(jsonData.current).to.have.property(\"wind_speed_10m\");\r\n});\r\n\r\npm.test(\"timezone is GMT\", function () {\r\n        pm.expect(jsonData.timezone).to.equal(\"GMT\");\r\n});\r\n\r\npm.test(\"hour and minute in the response\", function () {    \r\n    const time = jsonData.current.time;  \r\n    console.log(\"hour and minute: \" + time.substring(11,16));  \r\n});\r\n\r\n"
            ]
          }
        }
